{
  "name": "@realtime-copilot/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "RealTime Copilot 有线协议 v1：JSON Schema 事实源、生成的 TypeScript 类型与 Pydantic 模型、跨语言 fixtures",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schema": "./schema/events.v1.json",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "schema",
    "fixtures",
    "python"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
